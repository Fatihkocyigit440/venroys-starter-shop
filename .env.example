# Copy this file to .env.local for your computer, or add the same names in your
# hosting settings (Vercel → Project → Settings → Environment Variables).

# Required: your two Venroys keys (Venroys → Developers → API keys).
# Start with test keys (vr_pk_test_ / vr_sk_test_): they use the practice store and fake cards.
VENROYS_PUBLISHABLE_KEY=
VENROYS_SECRET_KEY=

# Your website address, for search engines and share links. No slash at the end.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: pay on your own site instead of the Venroys payment page.
# Only after Venroys has switched it on for your store, and with a publishable key
# whose allowed origins include this website's exact address.
NEXT_PUBLIC_VENROYS_CHECKOUT_MODE=hosted

# Optional: signing secrets from Venroys → Developers → Webhooks, comma-separated.
VENROYS_WEBHOOK_SECRETS=

# Optional: keep shoppers' carts when you replace the secret key (32+ random characters).
SESSION_SECRET=
